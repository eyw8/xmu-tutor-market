# XMU Tutor Market - backend environment template.
# Copy to `.env` and fill in real values: `cp .env.example .env`

# PostgreSQL 16 connection string used by Prisma.
DATABASE_URL="postgresql://xmu:xmu_secret@localhost:5432/xmu_tutor_market?schema=public"

# Redis 7 connection string (ioredis) - cache / throttler / verification codes.
REDIS_URL="redis://localhost:6379"

# JWT signing secret (change in production!) and token lifetime.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# HTTP port the API listens on.
PORT=4000

# Allowed browser origin for CORS.
FRONTEND_URL="http://localhost:3000"

# Optional SMTP (for future real email verification).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="XMU Tutor Market <no-reply@example.com>"
